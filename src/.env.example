# === Standalone OCR service (phase hiện tại) ===
OCR_SERVICE_KEY=dev-ocr-key-change-me
# true = không cần header X-Service-Key (chỉ local/demo)
OCR_AUTH_DISABLED=true

# 0 = PaddleOCR thật; 1 = mock luôn trả A0042 (chỉ smoke API)
OCR_MOCK=0
HOST=0.0.0.0
PORT=8089

THRESHOLD_AUTO=0.85
THRESHOLD_REVIEW_MIN=0.50
NEAR_DUP_HAMMING_MAX=5
BLUR_MIN_VARIANCE=40
MAX_IMAGE_SIDE=1600
MAX_INFLIGHT=1

OCR_DET_MODEL=PP-OCRv5_mobile_det
OCR_REC_MODEL=en_PP-OCRv5_mobile_rec
OCR_DET_LIMIT_SIDE_LEN=1280
OCR_WARMUP_ON_START=true

YOLO_ENABLED=true
YOLO_MODEL=yolov8n.pt
YOLO_CONF=0.25
YOLO_MAX_PEOPLE=8
YOLO_TORSO_PAD=0.08
# false = không OCR full-frame (tránh watermark/signage)
OCR_FULLFRAME_FALLBACK=false

# === Deferred — tích hợp Main WebAPI sau ===
# REDIS_URL=redis://127.0.0.1:6379/0
# WEBAPI_CALLBACK_BASE=http://127.0.0.1:5080
