# === Standalone OCR service (current phase) ===
OCR_SERVICE_KEY=dev-ocr-key-change-me
# true = skip X-Service-Key header (local/demo only)
OCR_AUTH_DISABLED=true

# 0 = real PaddleOCR; 1 = mock always returns A0042 (API smoke only)
OCR_MOCK=0
HOST=0.0.0.0
PORT=8089

THRESHOLD_AUTO=0.85
THRESHOLD_REVIEW_MIN=0.50
NEAR_DUP_HAMMING_MAX=5
BLUR_MIN_VARIANCE=40
MAX_IMAGE_SIDE=1600
# Parallel OCR jobs / process. Keep ≤2 while Paddle is CPU (shared RAM with YOLO).
# MUST match RaceDay WebAPI Photo:Ocr:WorkerMaxParallel (compose / appsettings).
# With YOLO CUDA + Paddle still CPU-wheel, 3–4 may OOM or timeout — raise carefully.
MAX_INFLIGHT=2
# Accepted bib digit length (default 3-6). Fun-run 3-digit OK; 1-2 digits are noisy.
BIB_MIN_DIGITS=3
BIB_MAX_DIGITS=6
# Max bib tags returned per photo (crowd)
BIB_MAX_TAGS=8

OCR_DET_MODEL=PP-OCRv5_mobile_det
OCR_REC_MODEL=en_PP-OCRv5_mobile_rec
OCR_DET_LIMIT_SIDE_LEN=1280
OCR_WARMUP_ON_START=true
# Device preference (see README §3.1). No GPU / VPS → leave auto (CPU fallback, no crash).
# auto = CUDA if torch/paddle usable else CPU | cpu = force CPU | cuda = prefer GPU (fallback CPU if missing)
OCR_DEVICE=auto
# Override YOLO only (empty = follow OCR_DEVICE). Useful when YOLO has torch CUDA
# but Paddle is CPU wheel (healthz.detail contains paddle_cpu_wheel) — Paddle is forced CPU in code.
YOLO_DEVICE=

YOLO_ENABLED=true
# YOLOv8 nano weights - do not switch to YOLO26/YOLO11 unless intentional
YOLO_MODEL=yolov8n.pt
YOLO_CONF=0.25
YOLO_IOU=0.88
YOLO_MAX_PEOPLE=10
YOLO_TORSO_PAD=0.08
YOLO_PERSON_FULL_RETRY=true
# false = do not OCR full frame (avoids watermark/signage)
OCR_FULLFRAME_FALLBACK=false

# === Deferred - Main WebAPI integration later ===
# REDIS_URL=redis://127.0.0.1:6379/0
# WEBAPI_CALLBACK_BASE=http://127.0.0.1:5080
