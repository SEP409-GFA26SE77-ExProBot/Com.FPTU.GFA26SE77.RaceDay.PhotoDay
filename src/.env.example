# === Standalone OCR service (current phase) ===
OCR_SERVICE_KEY=dev-ocr-key-change-me
# true = skip X-Service-Key header (local/demo only)
OCR_AUTH_DISABLED=true

# 0 = real PaddleOCR; 1 = mock always returns A0042 (API smoke only)
OCR_MOCK=0
HOST=0.0.0.0
PORT=8089

THRESHOLD_AUTO=0.85
THRESHOLD_REVIEW_MIN=0.50
NEAR_DUP_HAMMING_MAX=5
BLUR_MIN_VARIANCE=40
MAX_IMAGE_SIDE=1600
MAX_INFLIGHT=1
# Accepted bib digit length (default 3-6). Fun-run 3-digit OK; 1-2 digits are noisy.
BIB_MIN_DIGITS=3
BIB_MAX_DIGITS=6
# Max bib tags returned per photo (crowd)
BIB_MAX_TAGS=8

OCR_DET_MODEL=PP-OCRv5_mobile_det
OCR_REC_MODEL=en_PP-OCRv5_mobile_rec
OCR_DET_LIMIT_SIDE_LEN=1280
OCR_WARMUP_ON_START=true

YOLO_ENABLED=true
# YOLOv8 nano weights - do not switch to YOLO26/YOLO11 unless intentional
YOLO_MODEL=yolov8n.pt
YOLO_CONF=0.25
YOLO_MAX_PEOPLE=8
YOLO_TORSO_PAD=0.08
# false = do not OCR full frame (avoids watermark/signage)
OCR_FULLFRAME_FALLBACK=false

# === Deferred - Main WebAPI integration later ===
# REDIS_URL=redis://127.0.0.1:6379/0
# WEBAPI_CALLBACK_BASE=http://127.0.0.1:5080
